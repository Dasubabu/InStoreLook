{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": true,
    "@google/genai": true,
    "better-sqlite3": true,
    "protobufjs": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "qs": "^6.17.1"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "^1.2.3"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build:web": "vite build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/demoCatalog.test.ts src/commerce/client.test.ts src/commerce/server/shop.test.ts src/commerce/server/catalog.test.ts src/commerce/server/migrations.test.ts src/commerce/server/postgres.test.ts scripts/commerce-benchmark.test.ts src/components/customer/productGalleryHelpers.test.ts src/api/places.test.ts",
    "test:components": "tsx scripts/run-component-test.ts",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "benchmark:commerce": "tsx scripts/commerce-benchmark.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.11.2",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
